# copy to .env for local development. never commit .env.
# locally none of these are needed: comments use an in-memory store and a
# throwaway secret. on vercel (production + preview) set:

# signs proof-of-work challenges. 32+ random characters, e.g. `openssl rand -hex 32`
POW_SECRET=""

# added automatically when a vercel blob store is connected to the project
BLOB_READ_WRITE_TOKEN=""
# "private" (default) or "public" — must match how the blob store was created
BLOB_ACCESS="private"

# optional: lets the owner remove any comment (DELETE /api/comments with `authorization: Bearer <key>`)
BOSLEY_ADMIN_KEY=""
