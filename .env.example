# Copy to .env for local development. Never commit .env.
# On Vercel: Project → Settings → Environment Variables (all three, for Production + Preview).
# Values: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# Optional: Cloudflare Turnstile site key (enable the same in Supabase → Auth → Bot and Abuse Protection)
VITE_TURNSTILE_SITE_KEY=""
