---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---
<Base path="/">
  <section class="hero wrap">
    <p class="eyebrow reveal">bosley · est. 2024</p>
    <h1 class="display reveal" data-i="1">a quiet room<br /><em>on the internet.</em></h1>
    <p class="lede muted reveal" data-i="2">
      writing, and a place to answer it. no sign-ups, no ads, nothing following you around.
      say something under any post — anonymously, if you like.
    </p>
  </section>

  <section class="feed wrap" aria-labelledby="feed-h">
    <div class="feed-head">
      <h2 id="feed-h" class="eyebrow">the writing</h2>
      {posts.length > 1 && (
        <div class="toggle" role="radiogroup" aria-label="order the writing">
          <button type="button" role="radio" aria-checked="true" data-mode="latest">latest</button>
          <button type="button" role="radio" aria-checked="false" data-mode="foryou">for you</button>
          <span class="thumb" aria-hidden="true"></span>
        </div>
      )}
    </div>
    <p class="foryou-note faint" hidden>
      “for you” learns from what you finish reading — on this device only. nothing about it is sent anywhere.
    </p>

    {posts.length === 0 ? (
      <div class="empty reveal" data-i="3">
        <svg viewBox="0 0 120 120" width="96" height="96" aria-hidden="true" class="lamp">
          <defs>
            <radialGradient id="glow" cx="50%" cy="45%" r="55%">
              <stop offset="0" stop-color="#e6c27f" stop-opacity=".55" /><stop offset="1" stop-color="#e6c27f" stop-opacity="0" />
            </radialGradient>
          </defs>
          <circle cx="60" cy="54" r="54" fill="url(#glow)" class="halo" />
          <path d="M44 40h32l8 26H36z" fill="#2a1f15" stroke="#c9a46a" stroke-width="1.5" />
          <path d="M60 66v26M48 94h24" stroke="#8a6a3e" stroke-width="2" stroke-linecap="round" />
          <circle cx="60" cy="62" r="3" fill="#f3d99f" />
        </svg>
        <h3 class="display">the lamp is on. the first words are on their way.</h3>
        <p class="muted">nothing has been posted yet. follow along with <a href="/rss.xml">rss</a> — no account, no email.</p>
      </div>
    ) : (
      <ol class="list" data-feed>
        {posts.map((post, i) => <li><PostCard post={post} index={i} /></li>)}
      </ol>
    )}
    {posts.length > 0 && (
      <p class="caught-up faint reveal">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        you're all caught up. that's everything, for now.
      </p>
    )}
  </section>
</Base>

<script>
  import { initFeed } from "../scripts/feed";
  initFeed();
</script>

<style>
  .hero { padding-block: clamp(var(--s-7), 10vw, var(--s-9)) var(--s-7); }
  .hero h1 { font-size: var(--t-3xl); margin-top: var(--s-4); max-width: 14ch; }
  .hero h1 em { font-style: italic; color: var(--gold); }
  .lede { font-size: var(--t-md); max-width: 46ch; margin-top: var(--s-5); line-height: 1.55; }

  .feed-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-4); }
  .list { list-style: none; padding: 0; display: grid; gap: var(--s-4); }

  .toggle {
    position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: 4px;
    border: 1px solid var(--line-soft); border-radius: var(--radius-pill); background: var(--bg-deep);
  }
  .toggle button {
    position: relative; z-index: 1; min-height: 36px; padding: 0 var(--s-4); border: 0; background: none;
    font-size: var(--t-sm); color: var(--ink-muted); border-radius: var(--radius-pill);
    transition: color var(--d-fast) var(--ease-out);
  }
  .toggle button[aria-checked="true"] { color: oklch(0.18 0.03 60); }
  .thumb {
    position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: var(--radius-pill);
    background: linear-gradient(180deg, var(--gold-bright), var(--gold));
    box-shadow: 0 4px 14px -4px var(--gold-glow);
    transition: transform var(--d-base) var(--ease-spring);
  }
  .toggle:has([data-mode="foryou"][aria-checked="true"]) .thumb { transform: translateX(100%); }
  .foryou-note { font-size: var(--t-sm); margin-bottom: var(--s-4); }

  .empty {
    display: grid; justify-items: center; text-align: center; gap: var(--s-3);
    padding: var(--s-8) var(--s-5); border: 1px dashed var(--line); border-radius: var(--radius-lg);
    background: radial-gradient(60% 80% at 50% 0%, var(--gold-wash), transparent 70%);
  }
  .empty h3 { font-size: var(--t-xl); max-width: 24ch; }
  .lamp .halo { transform-origin: 60px 54px; animation: breathe 5s var(--ease-out) infinite alternate; }
  @keyframes breathe { from { opacity: 0.55; transform: scale(0.94); } to { opacity: 1; transform: scale(1.04); } }

  .caught-up { display: flex; align-items: center; justify-content: center; gap: var(--s-2); margin-top: var(--s-7); font-size: var(--t-sm); }
  .caught-up svg { color: var(--gold); }
</style>
