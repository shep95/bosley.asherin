---
import Base from "../../layouts/Base.astro";
import { allTags, getPosts } from "../../lib/posts";
const tags = allTags(await getPosts());
---
<Base path="/tags" title="topics" description="every topic written about on bosley.">
  <section class="prose-col page">
    <p class="eyebrow reveal">topics</p>
    <h1 class="display reveal" data-i="1">what the writing is about.</h1>
    {tags.length === 0 ? (
      <p class="muted reveal" data-i="2">no topics yet — they arrive with the first posts.</p>
    ) : (
      <ul class="cloud reveal" data-i="2">
        {tags.map(({ tag, count }) => <li><a class="chip" href={`/tags/${tag}`}>#{tag} <span class="faint">{count}</span></a></li>)}
      </ul>
    )}
  </section>
</Base>
<style>
  .page { padding-top: var(--s-8); }
  h1 { font-size: var(--t-2xl); margin: var(--s-3) 0 var(--s-6); }
  .cloud { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; padding: 0; }
  .cloud .chip { font-size: var(--t-sm); padding: 0.35rem 0.9rem; }
</style>
