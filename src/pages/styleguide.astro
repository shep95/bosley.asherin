---
import Base from "../layouts/Base.astro";
const swatches = [
  ["bg", "#060709"], ["scrim", "rgb 9 10 12 / .78"], ["hairline", "white / .07"], ["hairline-strong", "white / .14"],
  ["ink", "#f3f4f6"], ["ink-2", "ink / .78"], ["ink-3", "ink / .58"], ["ink-4", "ink / .45"], ["gold", "#d5b27a"],
];
---
<Base path="/styleguide" title="styleguide" description="bosley tokens and components." noindex>
  <section class="wrap sg">
    <p class="eyebrow">the room</p>
    <h1 class="hero-line">flat, quiet,<br /><em>one signal.</em></h1>

    <h2 class="eyebrow">color</h2>
    <ul class="sw">{swatches.map(([n, v]) => <li><span class={`chipc c-${n}`}></span><span class="meta">{n}</span><span class="meta">{v}</span></li>)}</ul>

    <h2 class="eyebrow">type</h2>
    <p class="hero-line">hero <em>line</em></p>
    <p class="serif t1">a post title, in serif</p>
    <p class="lede">a lede sentence, light and quiet.</p>
    <p>body text for reading, at seventy-eight percent ivory.</p>
    <p class="meta">meta · november 23, 2026 · 4 min read</p>

    <h2 class="eyebrow">controls</h2>
    <div class="row">
      <button class="btn btn--signal" type="button">post</button>
      <button class="btn" type="button">secondary</button>
      <button class="btn" type="button" disabled>disabled</button>
      <a class="quiet tab" href="#" aria-current="page">tab, current</a>
      <a class="quiet tab" href="#">tab</a>
    </div>
    <div class="row"><input class="field" placeholder="a field" /></div>

    <h2 class="eyebrow">motion</h2>
    <dl class="motion">
      <dt>fast · 120ms</dt><dd>hover, press, the ink line</dd>
      <dt>base · 200ms</dt><dd>tabs, toggles, header</dd>
      <dt>slow · 380ms</dt><dd>arrival, page transitions</dd>
      <dt>easing</dt><dd>cubic-bezier(0.22, 1, 0.36, 1): hard deceleration, no bounce, no loops</dd>
    </dl>
  </section>
</Base>
<style>
  .sg { padding-block: var(--s-8); display: grid; gap: var(--s-5); }
  h2 { margin-top: var(--s-6); border-top: 1px solid var(--hairline); padding-top: var(--s-3); }
  .sw { display: grid; grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); gap: var(--s-4); list-style: none; padding: 0; }
  .sw li { display: grid; gap: var(--s-1); }
  .chipc { height: 3.5rem; border-radius: var(--r-control); border: 1px solid var(--hairline-strong); }
  .c-bg { background: var(--bg); } .c-scrim { background: var(--scrim); } .c-hairline { background: var(--hairline); } .c-hairline-strong { background: var(--hairline-strong); }
  .c-ink { background: var(--ink); } .c-ink-2 { background: var(--ink-2); } .c-ink-3 { background: var(--ink-3); } .c-ink-4 { background: var(--ink-4); } .c-gold { background: var(--gold); }
  .t1 { font-size: var(--t-lg); }
  .row { display: flex; flex-wrap: wrap; gap: var(--s-5); align-items: center; max-width: 40rem; }
  .motion { display: grid; grid-template-columns: max-content 1fr; gap: var(--s-2) var(--s-6); font-size: var(--t-sm); }
  .motion dt { color: var(--ink); }
  .motion dd { color: var(--ink-3); font-weight: 300; }
</style>
