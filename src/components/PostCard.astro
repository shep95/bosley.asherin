---
import { Image } from "astro:assets";
import { formatDate, postUrl, readingMinutes, type Post } from "../lib/posts";
interface Props { post: Post; index: number }
const { post, index } = Astro.props;
const { title, description, date, tags, cover, coverAlt } = post.data;
const href = postUrl(post);
const mins = readingMinutes(post.body);
---
<article class="card reveal" data-i={Math.min(index, 6)} data-tags={tags.join(" ")} data-date={date.toISOString()} data-slug={post.id}>
  <a class="hit" href={href} aria-label={title}></a>
  {cover && (
    <div class="cover">
      <Image src={cover} alt={coverAlt ?? ""} widths={[480, 800, 1200]} sizes="(min-width: 48rem) 22rem, 100vw" loading={index < 2 ? "eager" : "lazy"} />
    </div>
  )}
  <div class="body">
    <p class="meta faint"><time datetime={date.toISOString()}>{formatDate(date)}</time> · {mins} min read</p>
    <h2 class="display title"><a href={href}>{title}</a></h2>
    <p class="desc muted">{description}</p>
    {tags.length > 0 && (
      <ul class="tags">{tags.map((t) => <li><a class="chip" href={`/tags/${t}`}>#{t}</a></li>)}</ul>
    )}
  </div>
  <span class="why faint" hidden></span>
</article>
<style>
  .card {
    position: relative; display: grid; gap: var(--s-4);
    padding: var(--s-5); border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface), oklch(0.175 0.014 62));
    border: 1px solid var(--line-soft); box-shadow: var(--shadow-2);
    transition: transform var(--d-base) var(--ease-out), border-color var(--d-base) var(--ease-out), box-shadow var(--d-slow) var(--ease-out);
  }
  .card:hover { transform: translateY(-2px); border-color: var(--line); box-shadow: var(--shadow-3), 0 0 0 1px var(--gold-wash); }
  .card:active { transform: translateY(0) scale(0.995); }
  @media (min-width: 48rem) { .card:has(.cover) { grid-template-columns: 22rem 1fr; align-items: center; } }
  .hit { position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .tags a, .title a { position: relative; z-index: 2; }
  .cover { overflow: hidden; border-radius: var(--radius); aspect-ratio: 16 / 10; background: var(--bg-deep); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--d-hero) var(--ease-out), filter var(--d-hero) var(--ease-out); filter: saturate(0.9) sepia(0.08); }
  .card:hover .cover :global(img) { transform: scale(1.03); filter: saturate(1) sepia(0); }
  .meta { font-size: var(--t-xs); letter-spacing: 0.06em; }
  .title { font-size: var(--t-xl); margin-top: var(--s-1); }
  .title a { text-decoration: none; }
  .card:hover .title a { color: var(--gold-bright); }
  .desc { margin-top: var(--s-2); max-width: 60ch; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; padding: 0; margin-top: var(--s-4); }
  .why { position: absolute; top: var(--s-4); right: var(--s-5); font-size: var(--t-xs); }
</style>
