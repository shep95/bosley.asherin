---
/** a bar: the mark in a chip and the wordmark on the left, quiet links and one
    gold pill on the right, nothing in between. */
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/", label: "writing" },
  { href: "/tags", label: "topics" },
  { href: "/about", label: "about" },
];
const on = (href: string) => (href === "/" ? here === "/" : here === href || here.startsWith(href + "/"));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="bosley, home">
      <span class="chip" aria-hidden="true">
        <svg viewBox="0 0 512 512" width="20" height="20" focusable="false"><path fill="currentColor" d="M258.98 427L164.10 427Q157.23 427 157.23 421.96L157.23 421.96Q157.23 417.83 163.19 416.46L163.19 416.46L173.73 414.63Q183.35 412.79 186.33 409.58Q189.31 406.38 189.31 396.75L189.31 396.75L189.31 127.25Q189.31 117.63 186.33 114.42Q183.35 111.21 173.73 109.38L173.73 109.38L163.19 107.54Q157.23 106.17 157.23 102.04L157.23 102.04Q157.23 97 164.10 97L164.10 97L257.15 97Q280.06 97 297.94 106.63Q315.81 116.25 326.13 132.75Q336.44 149.25 336.44 170.33L336.44 170.33Q336.44 190.96 324.29 208.60Q312.15 226.25 289.23 238.17L289.23 238.17Q286.48 239.54 286.48 241.83Q286.48 244.13 289.69 245.04L289.69 245.04Q320.85 255.58 337.81 278.73Q354.77 301.88 354.77 333.50L354.77 333.50Q354.77 360.54 342.40 381.85Q330.02 403.17 308.25 415.08Q286.48 427 258.98 427L258.98 427ZM246.15 238.63L246.15 238.63Q270.44 238.63 286.71 219.60Q302.98 200.58 302.98 172.17L302.98 172.17Q302.98 143.75 287.40 126.10Q271.81 108.46 246.15 108.46L246.15 108.46Q221.85 108.46 221.85 126.79L221.85 126.79L221.85 213.42Q221.85 226.71 227.58 232.67Q233.31 238.63 246.15 238.63ZM253.02 415.54L253.02 415.54Q282.81 415.54 301.60 392.85Q320.40 370.17 320.40 332.13L320.40 332.13Q320.40 294.08 301.38 272.08Q282.35 250.08 250.27 250.08L250.27 250.08Q221.85 250.08 221.85 272.54L221.85 272.54L221.85 383.92Q221.85 415.54 253.02 415.54Z" /></svg>
      </span>
      <span class="word">Bosley</span>
    </a>
    <nav aria-label="primary">
      <ul>
        {links.map((l) => (
          <li><a class="nav-link" href={l.href} aria-current={on(l.href) ? "page" : undefined}>{l.label}</a></li>
        ))}
        <li><button class="pill" type="button" data-compose aria-haspopup="dialog">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none" /></svg>
          write
        </button></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { sweepLegacy } from "../scripts/legacy";
  sweepLegacy();
  // the composer's code loads only when someone asks to write, so reading stays light
  for (const b of document.querySelectorAll<HTMLElement>("[data-compose]")) {
    const warm = () => { void import("../scripts/composer"); };
    b.addEventListener("pointerenter", warm, { once: true });
    b.addEventListener("focus", warm, { once: true });
    b.addEventListener("click", async () => (await import("../scripts/composer")).openComposer(b));
  }
  if (location.hash === "#write") document.querySelector<HTMLElement>("[data-compose]")?.click();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: var(--scrim-solid);
    border-bottom: 1px solid var(--hairline);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); height: 4rem; }

  .brand { display: inline-flex; align-items: center; gap: var(--s-3); color: var(--ink); }
  .chip {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px;
    background: rgb(255 255 255 / 0.05); border: 1px solid var(--hairline); color: var(--gold);
    transition: border-color var(--d-fast) var(--ease);
  }
  .brand:hover .chip { border-color: var(--hairline-strong); }
  .word { font-size: 1.125rem; font-weight: 550; letter-spacing: -0.01em; }

  ul { display: flex; align-items: center; gap: var(--s-6); list-style: none; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 1rem; font-weight: 400; color: rgb(243 244 246 / 0.62);
    transition: color var(--d-fast) var(--ease);
  }
  .nav-link:hover, .nav-link[aria-current="page"] { color: var(--ink); }
  .pill {
    display: inline-flex; align-items: center; gap: var(--s-2); height: 40px; padding: 0 var(--s-5); border: 0; border-radius: 10px;
    background: var(--gold); color: var(--gold-ink); font-size: 1rem; font-weight: 550; cursor: pointer;
    transition: background var(--d-fast) var(--ease), transform var(--d-fast) var(--ease);
  }
  .pill:hover { background: var(--gold-hi); }
  .pill:active { transform: scale(0.98); }

  @media (max-width: 40rem) {
    ul { gap: var(--s-4); }
    .nav-link, .pill { font-size: 0.875rem; }
    .pill { height: 36px; padding: 0 var(--s-4); }
  }
  @media (max-width: 26rem) {
    .word { display: none; }
    ul { gap: var(--s-3); }
  }
</style>
