---
import Brand from "./Brand.astro";
/** two separate pieces floating over the room, not a bar across it:
    the mark on the left, the way around on the right. same black, same
    hairline, same height, same radius — the wallpaper shows between them. */
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/", label: "writing" },
  { href: "/tags", label: "topics" },
  { href: "/about", label: "about" },
];
const on = (href: string) => (href === "/" ? here === "/" : here === href || here.startsWith(href + "/"));
---
<header class="site-header">
  <div class="wrap pieces">
    <div class="piece piece--brand"><Brand /></div>
    <nav class="piece piece--nav" aria-label="primary">
      <ul>
        {links.map((l) => (
          <li><a class="nav-link" href={l.href} aria-current={on(l.href) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <button class="pill" type="button" data-compose aria-haspopup="dialog">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none" /></svg>
        write
      </button>
    </nav>
  </div>
</header>

<script>
  import { sweepLegacy } from "../scripts/legacy";
  sweepLegacy();
  // the composer's code loads only when someone asks to write, so reading stays light
  for (const b of document.querySelectorAll<HTMLElement>("[data-compose]")) {
    const warm = () => { void import("../scripts/composer"); };
    b.addEventListener("pointerenter", warm, { once: true });
    b.addEventListener("focus", warm, { once: true });
    b.addEventListener("click", async () => (await import("../scripts/composer")).openComposer(b));
  }
  if (location.hash === "#write") document.querySelector<HTMLElement>("[data-compose]")?.click();
</script>

<style>
  /* the header itself is empty space; only the two pieces take clicks */
  .site-header { position: sticky; top: 0; z-index: 20; padding-top: var(--s-3); pointer-events: none; }
  .pieces { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .piece {
    pointer-events: auto; display: flex; align-items: center; height: 52px;
    background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--r-surface);
  }
  .piece--brand { padding: 0 var(--s-4) 0 8px; }
  .piece--nav { gap: var(--s-5); padding: 0 8px 0 var(--s-5); }

  ul { display: flex; align-items: center; gap: var(--s-5); list-style: none; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 0.9375rem; font-weight: 400; color: var(--ink-3);
    transition: color var(--d-fast) var(--ease);
  }
  .nav-link:hover, .nav-link[aria-current="page"] { color: var(--ink); }
  /* the one gold thing up here: the place you commit to writing */
  .pill {
    display: inline-flex; align-items: center; gap: var(--s-2); height: 36px; padding: 0 var(--s-4);
    border: 0; border-radius: var(--r-control); background: var(--gold); color: var(--gold-ink);
    font-size: 0.9375rem; font-weight: 550;
    transition: background var(--d-fast) var(--ease), transform var(--d-fast) var(--ease);
  }
  .pill:hover { background: var(--gold-hi); }
  .pill:active { transform: scale(0.98); }

  /* on a phone the gap between the pieces is too narrow for words to pass
     through cleanly, so the strip behind them is the room's own black */
  @media (max-width: 40rem) {
    .site-header { padding: var(--s-2) 0; background: var(--bg); }
    .pieces { width: calc(100% - 2 * var(--s-3)); }
    .piece { height: 48px; }
    .piece--nav { gap: var(--s-4); padding-left: var(--s-4); }
    ul { gap: var(--s-4); }
    .nav-link, .pill { font-size: 0.875rem; }
    .pill { height: 34px; padding: 0 var(--s-3); }
  }
  @media (max-width: 30rem) {
    .piece--brand { padding: 0 7px; }
    .piece--brand :global(.word) { display: none; }
  }
  @media (max-width: 22.5rem) {
    .pieces { gap: var(--s-2); width: calc(100% - 2 * var(--s-2)); }
    .piece--nav { gap: var(--s-3); padding-left: var(--s-3); }
    ul { gap: var(--s-3); }
    .pill { padding: 0 10px; }
    .pill svg { display: none; }
  }
</style>
