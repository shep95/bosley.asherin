---
import { SITE } from "../lib/site";

export interface SeoProps {
  title?: string;
  description?: string;
  path: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  published?: Date;
  modified?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const p = Astro.props as SeoProps;
const title = p.title ? `${p.title} · ${SITE.name}` : SITE.title;
const description = p.description ?? SITE.description;
const canonical = new URL(p.path, SITE.url).href;
const image = new URL(p.image ?? SITE.ogImage, SITE.url).href;
const imageAlt = p.imageAlt ?? "bosley — a quiet room on the internet.";

const graph = [
  {
    "@type": "Organization",
    "@id": `${SITE.url}/#org`,
    name: SITE.org.name,
    legalName: SITE.org.legalName,
    url: SITE.url,
    email: SITE.org.email,
    foundingDate: SITE.org.founded,
    logo: `${SITE.url}/favicon-192.png`,
    founder: { "@type": "Person", "@id": `${SITE.url}/#author`, name: SITE.author.name, url: SITE.author.url },
  },
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#site`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: SITE.lang,
    publisher: { "@id": `${SITE.url}/#org` },
  },
  ...(p.jsonLd ?? []),
];
const ld = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={p.noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />

<meta property="og:site_name" content="Bosley" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={p.type ?? "website"} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={p.title ?? SITE.tagline} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={imageAlt} />
{p.published && <meta property="article:published_time" content={p.published.toISOString()} />}
{p.modified && <meta property="article:modified_time" content={p.modified.toISOString()} />}
{p.tags?.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={p.title ?? SITE.tagline} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={ld} />
