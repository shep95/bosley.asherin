---
interface Props { post: string }
const { post } = Astro.props;
---
<section class="comments prose-col" id="conversation" aria-labelledby="conv-h" data-comments={post}>
  <header class="c-head">
    <h2 id="conv-h" class="display">the conversation</h2>
    <p class="count faint" data-count aria-live="polite"></p>
  </header>

  <ol class="c-list" data-list aria-busy="true">
    <li class="c-skel" aria-hidden="true"><span></span><span></span><span></span></li>
    <li class="c-skel" aria-hidden="true"><span></span><span></span></li>
  </ol>
  <p class="c-empty faint" data-empty hidden>no one has said anything yet. you could be first.</p>

  <form class="c-form" data-form novalidate>
    <label for="c-text" class="eyebrow">say something</label>
    <div class="ink-wrap">
      <textarea id="c-text" class="field" name="text" rows="4" maxlength="1000" required
        placeholder="plain words only. be kind; disagree well."
        aria-describedby="c-hint c-status" autocomplete="off" spellcheck="true"></textarea>
      <span class="ink" aria-hidden="true"></span>
    </div>

    <div class="c-row">
      <fieldset class="who">
        <legend class="visually-hidden">who is speaking</legend>
        <label><input type="radio" name="who" value="anon" checked /> <span>anonymous</span></label>
        <label><input type="radio" name="who" value="named" /> <span>with a name</span></label>
      </fieldset>
      <div class="meter" aria-hidden="true">
        <svg viewBox="0 0 36 36" width="28" height="28"><circle cx="18" cy="18" r="15" class="track" /><circle cx="18" cy="18" r="15" class="fill" pathLength="100" /></svg>
        <span data-left></span>
      </div>
    </div>

    <div class="named" data-named hidden>
      <label for="c-name" class="visually-hidden">your name</label>
      <input id="c-name" class="field" name="name" maxlength="32" autocomplete="nickname" placeholder="a name to sign with" />
      <p class="faint small">
        a private key is made on this device and signs what you write, so no one else can use your name's mark{" "}
        <span class="tag-preview" data-tag-preview></span>. it never leaves this browser. <button type="button" class="linkish" data-forget-key>forget my key</button>
      </p>
    </div>

    <div class="c-actions">
      <p id="c-hint" class="faint small">text only · up to 1,000 characters · no account, no email</p>
      <button class="btn btn--gold" type="submit" data-submit>post</button>
    </div>
    <p id="c-status" class="status small" data-status role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  import { initComments } from "../scripts/comments";
  initComments();
</script>

<style>
  .comments { margin-top: var(--s-9); padding-top: var(--s-7); border-top: 1px solid var(--line-soft); }
  .c-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); }
  .c-head h2 { font-size: var(--t-2xl); }
  .count { font-size: var(--t-sm); }

  .c-list { list-style: none; padding: 0; margin-top: var(--s-5); display: grid; gap: var(--s-3); }
  .c-list :global(.c) {
    padding: var(--s-4) var(--s-5); border-radius: var(--radius-lg); background: var(--surface);
    border: 1px solid var(--line-soft); animation: rise var(--d-slow) var(--ease-emph) both;
  }
  .c-list :global(.c.is-new) { animation: rise var(--d-slow) var(--ease-emph) both, arrive 1.6s var(--ease-out) both; }
  @keyframes arrive { from { box-shadow: 0 0 0 1px var(--gold), 0 0 40px -8px var(--gold-glow); } to { box-shadow: 0 0 0 1px transparent, 0 0 0 0 transparent; } }
  .c-list :global(.c-top) { display: flex; align-items: center; gap: var(--s-2); font-size: var(--t-sm); }
  .c-list :global(.c-name) { font-weight: 600; color: var(--ink); }
  .c-list :global(.c-anon) { color: var(--ink-muted); font-style: italic; font-family: var(--font-display); font-size: var(--t-md); }
  .c-list :global(.c-tag) { font-family: var(--font-mono); font-size: var(--t-xs); color: var(--gold); border: 1px solid var(--line); border-radius: var(--radius-pill); padding: 0 0.45rem; }
  .c-list :global(.c-time) { color: var(--ink-faint); font-size: var(--t-xs); margin-left: auto; }
  .c-list :global(.c-text) { margin-top: var(--s-2); white-space: pre-wrap; overflow-wrap: anywhere; color: oklch(0.9 0.022 78); }
  .c-list :global(.c-remove) { margin-top: var(--s-2); }
  .c-skel { display: grid; gap: 8px; padding: var(--s-5); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line-soft); }
  .c-skel span { height: 10px; border-radius: 6px; background: linear-gradient(90deg, var(--line-soft), var(--surface-raised), var(--line-soft)); background-size: 200% 100%; animation: shimmer 1.4s linear infinite; }
  .c-skel span:first-child { width: 30%; } .c-skel span:nth-child(2) { width: 90%; } .c-skel span:nth-child(3) { width: 70%; }
  @keyframes shimmer { to { background-position: -200% 0; } }
  .c-empty { margin-top: var(--s-4); }

  .c-form { margin-top: var(--s-6); display: grid; gap: var(--s-3); padding: var(--s-5); border-radius: var(--radius-lg); background: linear-gradient(180deg, var(--surface), transparent); border: 1px solid var(--line-soft); }
  .ink-wrap { position: relative; }
  .ink-wrap textarea { display: block; }
  /* the ink line fills as you write — a quiet sense of progress, never a nag */
  .ink { position: absolute; left: 12px; right: 12px; bottom: 0; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--gold-deep), var(--gold-bright)); transform-origin: left; transform: scaleX(var(--fill, 0)); transition: transform var(--d-fast) var(--ease-out), opacity var(--d-base) var(--ease-out); opacity: 0.85; pointer-events: none; }
  .c-row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; }
  .who { display: inline-flex; gap: var(--s-4); border: 0; padding: 0; font-size: var(--t-sm); }
  .who label { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; cursor: pointer; color: var(--ink-muted); }
  .who label:has(input:checked) { color: var(--ink); }
  .meter { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--t-xs); color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .meter svg { transform: rotate(-90deg); }
  .meter .track { fill: none; stroke: var(--line); stroke-width: 3; }
  .meter .fill { fill: none; stroke: var(--gold); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--pct, 0)); transition: stroke-dashoffset var(--d-fast) var(--ease-out), stroke var(--d-base) var(--ease-out); }
  .meter.warn .fill { stroke: oklch(0.78 0.13 65); }
  .meter.over .fill { stroke: var(--danger); }
  .named { display: grid; gap: var(--s-2); animation: rise var(--d-base) var(--ease-emph) both; }
  .small, .c-list :global(.small) { font-size: var(--t-xs); }
  .c-list :global(.linkish:hover) { color: var(--gold-bright); }
  .c-list :global(.linkish:disabled) { opacity: 0.5; }
  .c-actions { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; }
  .status { min-height: 1.2em; color: var(--ink-muted); }
  .status.err { color: var(--danger); }
  .status.ok { color: var(--ok); }
  .c-list :global(.linkish), .linkish { background: none; border: 0; padding: 0; color: var(--gold); text-decoration: underline; text-underline-offset: 0.2em; font-size: inherit; }
  .tag-preview { font-family: var(--font-mono); color: var(--gold); }
  [data-submit][aria-busy="true"] { position: relative; color: transparent; }
  [data-submit][aria-busy="true"]::after { content: ""; position: absolute; width: 16px; height: 16px; border-radius: 50%; border: 2px solid oklch(0.18 0.03 60 / 0.3); border-top-color: oklch(0.18 0.03 60); animation: spin 0.7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
