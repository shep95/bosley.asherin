---
import Brand from "./Brand.astro";
const year = new Date().getUTCFullYear();
const cols = [
  { title: "read", links: [["writing", "/"], ["topics", "/tags"]] },
  { title: "the room", links: [["about", "/about"], ["rules", "/rules"]] },
  { title: "trust", links: [["privacy", "/privacy"], ["security", "/.well-known/security.txt"]] },
];
const promises = ["no accounts", "no ads", "no tracking", "no database"];
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="about">
      <Brand />
      <p class="line">a quiet room on the internet. read, say something, leave when you want.</p>
      <ul class="promises">{promises.map((p) => <li>{p}</li>)}</ul>
    </div>
    <nav class="cols" aria-label="footer">
      {cols.map((c) => (
        <div>
          <p class="eyebrow">{c.title}</p>
          <ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="wrap bottom">
    <p>© {year} asherin</p>
    <p><a href="mailto:asher@bosley.app">asher@bosley.app</a></p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--s-9); background: var(--scrim-solid); border-top: 1px solid var(--hairline); }
  .top { display: grid; gap: var(--s-7); padding: var(--s-8) 0 var(--s-7); }
  @media (min-width: 52rem) { .top { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); } }

  .line { margin-top: var(--s-4); max-width: 30ch; font-size: var(--t-sm); font-weight: 300; line-height: 1.6; color: var(--ink-3); }
  .promises { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; padding: 0; margin-top: var(--s-5); }
  .promises li {
    font-size: var(--t-xs); color: var(--ink-3); padding: 0.3rem 0.7rem; border-radius: var(--r-control);
    border: 1px solid var(--hairline-strong);
  }

  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
  @media (max-width: 30rem) { .cols { gap: var(--s-4); } }
  .cols ul { list-style: none; padding: 0; margin-top: var(--s-4); display: grid; gap: var(--s-3); }
  .cols a { font-size: var(--t-sm); font-weight: 350; color: var(--ink-3); transition: color var(--d-fast) var(--ease); }
  .cols a:hover { color: var(--ink); }

  .bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3);
    padding: var(--s-5) 0 var(--s-6); border-top: 1px solid var(--hairline);
    font-size: var(--t-xs); font-weight: 300; color: var(--ink-4);
  }
  .bottom a { color: var(--ink-4); transition: color var(--d-fast) var(--ease); }
  .bottom a:hover { color: var(--ink); }
</style>
