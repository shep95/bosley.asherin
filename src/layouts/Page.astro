---
import Base from "./Base.astro";
interface Props { path: string; title: string; description: string; eyebrow: string; noindex?: boolean }
const { eyebrow, ...rest } = Astro.props;
---
<Base {...rest}>
  <article class="col page">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 class="serif reveal" data-i="1">{rest.title}</h1>
    <div class="body reveal" data-i="2"><slot /></div>
  </article>
</Base>
<style>
  .page { padding-top: clamp(var(--s-8), 10vw, 9rem); }
  h1 { font-size: clamp(2.4rem, 5vw, 3.75rem); line-height: 1.02; letter-spacing: -0.02em; margin: var(--s-5) 0 var(--s-7); color: var(--ink); }
  .body { border-top: 1px solid var(--hairline); padding-top: var(--s-6); color: var(--ink-2); }
  .body :global(> * + *) { margin-top: 1.15em; }
  .body :global(h2) { font-family: var(--font-display); font-size: var(--t-lg); line-height: 1.1; color: var(--ink); margin-top: 1.8em; }
  .body :global(ul) { padding-left: 1.2em; }
  .body :global(li + li) { margin-top: 0.4em; }
  .body :global(li::marker) { color: var(--ink-4); }
  .body :global(strong) { font-weight: 550; color: var(--ink); }
  .body :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--gold-line); text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
</style>
