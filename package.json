{
  "name": "bosley",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "bosley \u2014 a quiet room on the internet. static-first blog with anonymous, text-only comments. no accounts, no database, no tracking.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/scrub-images.mjs && astro build && node scripts/scrub-images.mjs --roots=dist/client,.vercel/output/static",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "images:scrub": "node scripts/scrub-images.mjs",
    "images:check": "node scripts/scrub-images.mjs --check",
    "check": "npm run images:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.9.9",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "*",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "path-to-regexp@6": "^6.3.0",
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
